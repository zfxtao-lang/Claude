# Gateway Auth
GATEWAY_AUTH_TOKEN=your-secret-token-here

# API Providers (prefix-based routing)
# OpenRouter: handles anthropic/, openai/, google/ models
OPENROUTER_API_KEY=sk-or-xxx
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120

# DeepSeek: handles deepseek-* models
DEEPSEEK_API_KEY=sk-xxx
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_TIMEOUT=120

# Zhipu (GLM): handles glm-* models
ZHIPU_API_KEY=xxx
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_TIMEOUT=120

# Alibaba (Qwen): handles qwen-* models
ALIBABA_API_KEY=sk-xxx
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_TIMEOUT=120

# Database
DB_PATH=/opt/gateway/chats.db
DB_BACKUP_DIR=/opt/gateway/backups
DB_BACKUP_KEEP_DAYS=30

# Notion
NOTION_TOKEN=ntn_xxx
NOTION_PAGE_IDS=page-id-1,page-id-2
NOTION_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_RPM=30
RATE_LIMIT_RPD=500

# CORS
CORS_ALLOWED_ORIGINS=*

# System Prompt
SYSTEM_PROMPT_FILE=/opt/gateway/system_prompt.txt
