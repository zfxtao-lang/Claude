# Gateway Auth
GATEWAY_AUTH_TOKEN=your-secret-token-here

# API Keys (referenced by ${VAR_NAME} in providers.json)
# Add new providers: edit providers.json, add key here, POST /admin/providers/reload
OPENROUTER_API_KEY=sk-or-xxx
DEEPSEEK_API_KEY=sk-xxx
ZHIPU_API_KEY=xxx
ALIBABA_API_KEY=sk-xxx

# Provider config file (default: providers.json)
# PROVIDERS_FILE=/opt/gateway/providers.json

# Database
DB_PATH=/opt/gateway/chats.db
DB_BACKUP_DIR=/opt/gateway/backups
DB_BACKUP_KEEP_DAYS=30

# Notion
NOTION_TOKEN=ntn_xxx
NOTION_PAGE_IDS=2de7ad9d7c2c81ce9b28f67b0039f780,2de7ad9d7c2c81c5b2e5c7a643a0edce
NOTION_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_RPM=30
RATE_LIMIT_RPD=500

# CORS
CORS_ALLOWED_ORIGINS=*

# System Prompt
SYSTEM_PROMPT_FILE=/opt/gateway/system_prompt.txt

# Vector Search (Alibaba text-embedding-v3)
# ALIBABA_API_KEY is shared with chat provider above
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=768
VECTOR_FILE=/opt/gateway/vectors.npy
VECTOR_IDS_FILE=/opt/gateway/vectors_ids.npy
VECTOR_CHUNK_ROUNDS=4
