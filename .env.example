# Gateway Auth
GATEWAY_AUTH_TOKEN=your-secret-token-here

# API Providers
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
DEEPSEEK_API_KEY=sk-xxx

# Timeouts (seconds)
OPENAI_TIMEOUT=120
ANTHROPIC_TIMEOUT=120
DEEPSEEK_TIMEOUT=120

# Database
DB_PATH=/opt/gateway/chats.db
DB_BACKUP_DIR=/opt/gateway/backups
DB_BACKUP_KEEP_DAYS=30

# Notion
NOTION_TOKEN=ntn_xxx
NOTION_PAGE_IDS=page-id-1,page-id-2
NOTION_CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_RPM=30
RATE_LIMIT_RPD=500

# CORS
CORS_ALLOWED_ORIGINS=*

# System Prompt
SYSTEM_PROMPT_FILE=/opt/gateway/system_prompt.txt
